<Window
    x:Class="v2rayN.Desktop.Views.OpenCodeWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.OpenCodeTitle}"
    Width="820"
    Height="640"
    x:DataType="vms:OpenCodeViewModel"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel Margin="{StaticResource Margin8}">
        <StackPanel
            Margin="{StaticResource Margin4}"
            HorizontalAlignment="Center"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnTest"
                Width="120"
                Margin="{StaticResource MarginLr8}"
                Content="{x:Static resx:ResUI.OpenCodeTestConnection}" />
            <Button
                x:Name="btnRefreshModels"
                Width="120"
                Margin="{StaticResource MarginLr8}"
                Content="{x:Static resx:ResUI.OpenCodeRefreshModels}" />
            <Button
                x:Name="btnSave"
                Width="100"
                Content="{x:Static resx:ResUI.TbConfirm}"
                IsDefault="True" />
            <Button
                x:Name="btnCancel"
                Width="100"
                Margin="{StaticResource MarginLr8}"
                Content="{x:Static resx:ResUI.TbCancel}"
                IsCancel="True" />
        </StackPanel>

        <TabControl HorizontalContentAlignment="Stretch">
            <TabItem Header="{x:Static resx:ResUI.OpenCodeTabDashboard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="{StaticResource Margin4}" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="{StaticResource Margin4}" Text="{x:Static resx:ResUI.OpenCodeGatewayState}" />
                        <TextBox x:Name="txtGatewayStatus" Grid.Row="0" Grid.Column="1" Margin="{StaticResource Margin4}" IsReadOnly="True" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="{StaticResource Margin4}" Text="{x:Static resx:ResUI.OpenCodeEndpoint}" />
                        <TextBox x:Name="txtEndpoint" Grid.Row="1" Grid.Column="1" Margin="{StaticResource Margin4}" IsReadOnly="True" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="{StaticResource Margin4}" Text="{x:Static resx:ResUI.OpenCodeProfile}" />
                        <TextBox x:Name="txtProfile" Grid.Row="2" Grid.Column="1" Margin="{StaticResource Margin4}" IsReadOnly="True" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="{StaticResource Margin4}" Text="{x:Static resx:ResUI.OpenCodeProxyStatus}" />
                        <TextBox x:Name="txtProxy" Grid.Row="3" Grid.Column="1" Margin="{StaticResource Margin4}" IsReadOnly="True" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="{StaticResource Margin4}" Text="{x:Static resx:ResUI.OpenCodeEgressIp}" />
                        <TextBox x:Name="txtEgressIp" Grid.Row="4" Grid.Column="1" Margin="{StaticResource Margin4}" IsReadOnly="True" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Margin="{StaticResource Margin4}" Text="{x:Static resx:ResUI.OpenCodeTestResult}" />
                        <TextBox x:Name="txtTestResult" Grid.Row="5" Grid.Column="1" Margin="{StaticResource Margin4}" IsReadOnly="True" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Margin="{StaticResource Margin4}" Text="{x:Static resx:ResUI.OpenCodeTelemetry}" />
                        <TextBox x:Name="txtTelemetry" Grid.Row="6" Grid.Column="1" Margin="{StaticResource Margin4}" IsReadOnly="True" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="7" Grid.Column="0" Margin="{StaticResource Margin4}" Text="{x:Static resx:ResUI.OpenCodeClientExample}" />
                        <TextBox x:Name="txtClientExample" Grid.Row="7" Grid.Column="1" Margin="{StaticResource Margin4}" IsReadOnly="True" TextWrapping="Wrap" />
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{x:Static resx:ResUI.OpenCodeTabModels}">
                <DockPanel Margin="{StaticResource Margin4}">
                    <Border
                        DockPanel.Dock="Top"
                        Margin="{StaticResource Margin4}"
                        Padding="{StaticResource Margin4}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,4,0"
                                FontWeight="Bold"
                                Text="{x:Static resx:ResUI.OpenCodeSelectedModel}:" />
                            <TextBlock x:Name="txtSelectedModel" Text="{Binding SelectedModelDisplay}" />
                        </StackPanel>
                    </Border>

                    <DockPanel DockPanel.Dock="Top" Margin="{StaticResource Margin4}">
                        <TextBox
                            x:Name="txtModelFilter"
                            Width="180"
                            DockPanel.Dock="Left"
                            VerticalContentAlignment="Center"
                            PlaceholderText="{x:Static resx:ResUI.OpenCodeModelFilter}"
                            Text="{Binding ModelFilter, Mode=TwoWay}" />
                        <CheckBox
                            x:Name="chkFreeOnly"
                            Margin="{StaticResource MarginLr8}"
                            DockPanel.Dock="Left"
                            Content="{x:Static resx:ResUI.OpenCodeFreeOnly}"
                            IsChecked="{Binding FilterFreeOnly, Mode=TwoWay}" />
                        <ComboBox
                            x:Name="cboApiStyleFilter"
                            Width="140"
                            Margin="{StaticResource MarginLr8}"
                            DockPanel.Dock="Left"
                            SelectedIndex="{Binding ModelApiStyleFilterIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{x:Static resx:ResUI.OpenCodeFilterAll}" />
                            <ComboBoxItem Content="{x:Static resx:ResUI.OpenCodeFilterChatCompletions}" />
                            <ComboBoxItem Content="{x:Static resx:ResUI.OpenCodeFilterResponses}" />
                        </ComboBox>
                        <ComboBox
                            x:Name="cboSort"
                            Width="140"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            SelectedIndex="{Binding ModelSortIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{x:Static resx:ResUI.OpenCodeSortNameAsc}" />
                            <ComboBoxItem Content="{x:Static resx:ResUI.OpenCodeSortNameDesc}" />
                            <ComboBoxItem Content="{x:Static resx:ResUI.OpenCodeSortApiStyle}" />
                            <ComboBoxItem Content="{x:Static resx:ResUI.OpenCodeSortFreeFirst}" />
                            <ComboBoxItem Content="{x:Static resx:ResUI.OpenCodeSortSource}" />
                        </ComboBox>
                    </DockPanel>

                    <TextBlock
                        DockPanel.Dock="Top"
                        Margin="{StaticResource Margin4}"
                        Text="{Binding ModelCountDisplay}" />

                    <DataGrid
                        x:Name="grdModels"
                        AutoGenerateColumns="False"
                        BorderThickness="1"
                        CanUserReorderColumns="True"
                        CanUserResizeColumns="True"
                        GridLinesVisibility="All"
                        HeadersVisibility="All"
                        IsReadOnly="True"
                        ItemsSource="{Binding ModelRows}"
                        SelectedItem="{Binding SelectedModelRow, Mode=TwoWay}"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="60" SortMemberPath="IsFree">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Label
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Content="{x:Static resx:ResUI.OpenCodeFreeBadge}"
                                            IsVisible="{Binding IsFree}"
                                            Theme="{DynamicResource TagLabel}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding Id}"
                                Header="{x:Static resx:ResUI.OpenCodeColumnId}" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding DisplayName}"
                                Header="{x:Static resx:ResUI.OpenCodeColumnDisplayName}" />
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding ApiStyle}"
                                Header="{x:Static resx:ResUI.OpenCodeColumnApiStyle}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Source}"
                                Header="{x:Static resx:ResUI.OpenCodeColumnSource}" />
                            <DataGridCheckBoxColumn
                                Width="60"
                                Binding="{Binding SupportsTools}"
                                Header="{x:Static resx:ResUI.OpenCodeColumnTools}" />
                            <DataGridCheckBoxColumn
                                Width="70"
                                Binding="{Binding SupportsStreaming}"
                                Header="{x:Static resx:ResUI.OpenCodeColumnStreaming}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="{x:Static resx:ResUI.OpenCodeTabSettings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="{StaticResource Margin4}" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <CheckBox x:Name="chkEnabled" Grid.Row="0" Grid.Column="1" Margin="{StaticResource Margin4}" Content="{x:Static resx:ResUI.OpenCodeEnabled}" />
                        <CheckBox x:Name="chkGatewayEnabled" Grid.Row="1" Grid.Column="1" Margin="{StaticResource Margin4}" Content="{x:Static resx:ResUI.OpenCodeGatewayEnabled}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="{StaticResource Margin4}" Text="{x:Static resx:ResUI.OpenCodeDefaultTarget}" />
                        <TextBox x:Name="txtDefaultTarget" Grid.Row="2" Grid.Column="1" Margin="{StaticResource Margin4}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="{StaticResource Margin4}" Text="{x:Static resx:ResUI.OpenCodeDefaultModel}" />
                        <TextBox x:Name="txtDefaultModel" Grid.Row="3" Grid.Column="1" Margin="{StaticResource Margin4}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="{StaticResource Margin4}" Text="{x:Static resx:ResUI.OpenCodeGatewayHost}" />
                        <TextBox x:Name="txtGatewayHost" Grid.Row="4" Grid.Column="1" Margin="{StaticResource Margin4}" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Margin="{StaticResource Margin4}" Text="{x:Static resx:ResUI.OpenCodeGatewayPort}" />
                        <TextBox x:Name="txtGatewayPort" Grid.Row="5" Grid.Column="1" Margin="{StaticResource Margin4}" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Margin="{StaticResource Margin4}" Text="{x:Static resx:ResUI.OpenCodeConnectTimeout}" />
                        <TextBox x:Name="txtConnectTimeout" Grid.Row="6" Grid.Column="1" Margin="{StaticResource Margin4}" />
                        <TextBlock Grid.Row="7" Grid.Column="0" Margin="{StaticResource Margin4}" Text="{x:Static resx:ResUI.OpenCodeRequestTimeout}" />
                        <TextBox x:Name="txtRequestTimeout" Grid.Row="7" Grid.Column="1" Margin="{StaticResource Margin4}" />
                        <TextBlock Grid.Row="8" Grid.Column="0" Margin="{StaticResource Margin4}" Text="{x:Static resx:ResUI.OpenCodeMaxRetry}" />
                        <TextBox x:Name="txtMaxRetry" Grid.Row="8" Grid.Column="1" Margin="{StaticResource Margin4}" />
                        <TextBlock Grid.Row="9" Grid.Column="0" Margin="{StaticResource Margin4}" Text="{x:Static resx:ResUI.OpenCodeMaxConcurrent}" />
                        <TextBox x:Name="txtMaxConcurrent" Grid.Row="9" Grid.Column="1" Margin="{StaticResource Margin4}" />
                        <TextBlock Grid.Row="10" Grid.Column="0" Margin="{StaticResource Margin4}" Text="{x:Static resx:ResUI.OpenCodeTargetName}" />
                        <TextBox x:Name="txtTargetName" Grid.Row="10" Grid.Column="1" Margin="{StaticResource Margin4}" />
                        <TextBlock Grid.Row="11" Grid.Column="0" Margin="{StaticResource Margin4}" Text="{x:Static resx:ResUI.OpenCodeTargetBaseUrl}" />
                        <TextBox x:Name="txtTargetBaseUrl" Grid.Row="11" Grid.Column="1" Margin="{StaticResource Margin4}" />
                        <TextBlock Grid.Row="12" Grid.Column="0" Margin="{StaticResource Margin4}" Text="{x:Static resx:ResUI.OpenCodeTargetCatalogUrl}" />
                        <TextBox x:Name="txtTargetCatalogUrl" Grid.Row="12" Grid.Column="1" Margin="{StaticResource Margin4}" />
                        <TextBlock Grid.Row="13" Grid.Column="0" Margin="{StaticResource Margin4}" Text="{x:Static resx:ResUI.OpenCodeApiKey}" />
                        <StackPanel Grid.Row="13" Grid.Column="1" Margin="{StaticResource Margin4}" Orientation="Horizontal">
                            <TextBox x:Name="txtApiKey" Width="280" />
                            <Button
                                x:Name="btnSaveApiKey"
                                Width="100"
                                Margin="{StaticResource MarginLr8}"
                                Content="{x:Static resx:ResUI.OpenCodeSaveApiKey}" />
                            <Button
                                x:Name="btnClearApiKey"
                                Width="100"
                                Content="{x:Static resx:ResUI.OpenCodeClearApiKey}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
